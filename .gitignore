# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# dsh-graph workspace data (local only, never commit)
.dsh-graph/

# Local build output (distributed via GitHub Releases instead)
output/

# Internal project docs (requirements/archives/analysis, local only, never commit)
docs/

# dsh-graph isolated worktrees (parallel attempt checkouts, never commit)
.worktrees/
